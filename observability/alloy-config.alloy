// Grafana Alloy 配置 —— 日志采集端
//
// 为什么是 Alloy 而不是 promtail：
//   promtail 于 2025-02-13 进入 LTS、**2026-03-02 到达 EOL**（商业支持终止、
//   不再有安全补丁与缺陷修复），并在 Loki 3.7.3 中从仓库移除。
//   Alloy 是 Grafana 官方指定的继任者（Grafana Agent 也于 2025-11-01 EOL，
//   两条线统一收敛到 Alloy）。决策全文见 docs/adr/0004。
//
// 采集两类来源：systemd journal（系统日志）+ Docker 容器日志
//
// ⚠️ 权限取舍（已知并接受）：下面挂了 /var/run/docker.sock —— 这等于把宿主 root 的
//    等效能力给了容器，安全性上并不便宜。之所以仍然这么选：
//      - docker.sock 是拿到「容器名 / compose service / 标签」这类元数据的唯一实用途径；
//        改读 /var/lib/docker/containers/*/*-json.log 虽然不需要 socket，
//        但必须自己 parse JSON 并从路径反推容器身份，元数据会明显变糙。
//      - 该 socket 已挂为 :ro，且 Alloy 只做只读发现；
//      - 本机是学习环境，防护层次见 docs/baseline.md「二、安全」。
//    若将来要收紧，方向是改用 file_match + loki.source.file 走日志文件，放弃富元数据。

// ── 出口 1：先丢掉「陈旧条目」，再写给 Loki ──────────────────────────────
//
// 为什么需要这一层（2026-10-14 实测踩到）：
//   Alloy 首次启动会**从容器日志文件的开头读起**。实测 web 容器的 json 日志整份都是
//   2026-09-24 的内容（20 天前），grafana 的是 08:55 的启动日志。这些条目被 Loki 按
//   两条机制拒收 —— reject_old_samples_max_age（默认 1w）判「too old」，
//   max_chunk_age（1h）判「too far behind」。
//   被拒的批次会持续重试 → Loki 日志里每 30~90 秒刷一批 error，真正有价值的新日志
//   淹没在噪声里。**在客户端就丢掉，既不浪费带宽也不污染后端日志。**
//
// 阈值取 1h 的依据：与 Loki 生效配置里的 max_chunk_age 对齐（用 `/config` 端点读到的
// 运行态，不是猜的）。journal 源原本 max_age=12h 也一并收到 1h，两个来源保持同一语义。
loki.process "drop_stale" {
  forward_to = [loki.write.local.receiver]

  stage.drop {
    older_than          = "1h"
    drop_counter_reason = "stale_on_first_read"
  }
}

// ── 来源 1：systemd journal ────────────────────────────────────────────
loki.relabel "journal" {
  forward_to = []                    // 仅作为规则集被引用，不直接转发

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    // 目的：把数值优先级翻成可读 level，便于 {level="err"} 直接筛
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "system" {
  path   = "/var/log/journal"
  // 目的：不要回溯陈年日志。取 1h 是与 drop_stale 的阈值保持一致，
  //       免得读出来又立刻被自己丢掉，白跑一遍。
  max_age       = "1h"
  labels        = { job = "systemd-journal", host = constants.hostname }
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.process.drop_stale.receiver]
}

// ── 来源 2：Docker 容器日志 ────────────────────────────────────────────
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

loki.relabel "docker" {
  forward_to = []

  rule {
    // 容器名带前导 "/"，去掉
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    // 目的：用 compose 的 service 名当标签，比容器名稳定
    //（容器名可能带随机后缀，是典型的"高基数陷阱"）
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  labels        = { job = "docker", host = constants.hostname }
  relabel_rules = loki.relabel.docker.rules
  forward_to    = [loki.process.drop_stale.receiver]
}

// ── 出口 2：写入 Loki ─────────────────────────────────────────────────
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  external_labels = { agent = "alloy" }
}
